# SMTP (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_NAME=email_dispatcher
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# PostgreSQL Connection Pool
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_POOL_SIZE=5
REDIS_MIN_IDLE_CONNS=2
REDIS_DIAL_TIMEOUT=5s

# Rate Limiting
EMAIL_RATE_LIMIT=10
EMAIL_RATE_WINDOW=1s
