From: "Screenlaps" <hello@screenlaps.com>
To: {{.Email}}
Subject: Welcome to Screenlaps, {{.Name}}! 🚀
MIME-Version: 1.0
Content-Type: text/html; charset="UTF-8"

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome to Screenlaps</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f3f4f6; color: #1f2937;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color: #f3f4f6; padding: 40px 10px;">
    <tr>
      <td align="center">
        <!-- Main Email Container -->
        <table role="presentation" width="100%" style="max-width: 600px; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);">
          
          <!-- Header Banner -->
          <tr>
            <td style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); padding: 36px 32px; text-align: center;">
              <h1 style="margin: 0; color: #ffffff; font-size: 26px; font-weight: 700; letter-spacing: -0.5px;">Screenlaps</h1>
              <p style="margin: 8px 0 0 0; color: #e0e7ff; font-size: 14px;">Next-Gen Workflow Automation</p>
            </td>
          </tr>

          <!-- Body Content -->
          <tr>
            <td style="padding: 36px 32px;">
              <h2 style="margin: 0 0 16px 0; color: #111827; font-size: 20px; font-weight: 600;">Welcome aboard, {{.Name}}! 👋</h2>
              
              <p style="margin: 0 0 16px 0; font-size: 15px; line-height: 1.6; color: #4b5563;">
                Thanks for joining us! Your account associated with <strong>{{.Email}}</strong> has been successfully configured and is ready to roll.
              </p>

              <p style="margin: 0 0 24px 0; font-size: 15px; line-height: 1.6; color: #4b5563;">
                Screenlaps helps you automate, capture, and dispatch workflows with blazing speed. Here are 3 quick steps to get the most out of your experience:
              </p>

              <!-- Feature Highlights / Steps -->
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-bottom: 28px;">
                <tr>
                  <td style="padding: 12px 16px; background-color: #f9fafb; border-radius: 8px; margin-bottom: 8px;">
                    <div style="font-weight: 600; color: #1f2937; font-size: 14px;">⚡ 1. Set Up Your Dashboard</div>
                    <div style="color: #6b7280; font-size: 13px; margin-top: 4px;">Customize alerts, worker pools, and notification thresholds.</div>
                  </td>
                </tr>
                <tr><td style="height: 10px;"></td></tr>
                <tr>
                  <td style="padding: 12px 16px; background-color: #f9fafb; border-radius: 8px;">
                    <div style="font-weight: 600; color: #1f2937; font-size: 14px;">👥 2. Invite Your Team</div>
                    <div style="color: #6b7280; font-size: 13px; margin-top: 4px;">Collaborate across pipelines and monitor concurrent dispatchers in real time.</div>
                  </td>
                </tr>
                <tr><td style="height: 10px;"></td></tr>
                <tr>
                  <td style="padding: 12px 16px; background-color: #f9fafb; border-radius: 8px;">
                    <div style="font-weight: 600; color: #1f2937; font-size: 14px;">📈 3. Explore Analytics</div>
                    <div style="color: #6b7280; font-size: 13px; margin-top: 4px;">Gain instant visibility into throughput, latency, and delivery rates.</div>
                  </td>
                </tr>
              </table>

              <!-- Call to Action Button -->
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-bottom: 28px;">
                <tr>
                  <td align="center">
                    <a href="https://screenlaps.com/dashboard" style="display: inline-block; background-color: #4f46e5; color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 8px; font-weight: 600; font-size: 15px; box-shadow: 0 2px 4px rgba(79, 70, 229, 0.3);">
                      Launch Dashboard &rarr;
                    </a>
                  </td>
                </tr>
              </table>

              <p style="margin: 0; font-size: 14px; line-height: 1.6; color: #6b7280;">
                If you have any questions or feedback, just reply directly to this email—we’re always happy to help!
              </p>

              <p style="margin: 20px 0 0 0; font-size: 14px; line-height: 1.6; color: #374151;">
                Cheers,<br>
                <strong>The Screenlaps Team</strong>
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color: #f9fafb; padding: 24px 32px; text-align: center; border-top: 1px solid #e5e7eb;">
              <p style="margin: 0; font-size: 12px; color: #9ca3af; line-height: 1.5;">
                &copy; 2026 Screenlaps Inc. All rights reserved.<br>
                100 Innovation Way, Suite 400, San Francisco, CA 94107
              </p>
              <p style="margin: 8px 0 0 0; font-size: 12px; color: #9ca3af;">
                <a href="https://screenlaps.com/preferences" style="color: #6b7280; text-decoration: underline;">Email Preferences</a> &bull; 
                <a href="https://screenlaps.com/unsubscribe" style="color: #6b7280; text-decoration: underline;">Unsubscribe</a>
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
